# Copy to .env.production (or set these in your host's environment variables).

# Your live website address, no trailing slash. Needed for link previews (WhatsApp, Instagram, iMessage).
VITE_SITE_URL=https://your-live-site.example

# Optional: a Formspree (or similar) form URL. When set, checkout gets a "Send order request"
# button so orders reach you even if the customer never presses Send in WhatsApp or email.
VITE_ORDER_ENDPOINT=

# Optional: newsletter sign-ups.
VITE_NEWSLETTER_ENDPOINT=
